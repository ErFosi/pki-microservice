# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y cambia los valores

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pki_db

# Security - MASTER KEY para cifrado
#  CRÍTICO: Esta clave se usa para cifrar las claves privadas de las CAs
# 
# CÓMO GENERAR UNA MASTER_KEY SEGURA:
# 
# Opción 1 - Python (Recomendado):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Opción 2 - OpenSSL:
#   openssl rand -base64 32
#
# Opción 3 - /dev/urandom (Linux):
#   cat /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 44
#
# La clave debe tener al menos 32 caracteres para ser segura.
# Una vez generada, NUNCA la cambies o perderás acceso a las claves cifradas.
# NUNCA la commitees a Git.
#
MASTER_KEY=CHANGE_ME_TO_A_SECURE_KEY_GENERATED_WITH_COMMANDS_ABOVE

# JWT Authentication
# CÓMO GENERAR SECRET_KEY:
#   openssl rand -hex 32
# O:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Services URLs (interno en Docker)
CA_SERVICE_URL=http://ca-service:8001

# Application
DEBUG=True
APP_NAME=CA Service
